PORT=3000
# Origen de la web. La API se sirve en {APP_URL}/api (en local, vía el proxy de Vite)
APP_URL=http://localhost:5173
# Otros dominios de la web que también llaman a la API (p. ej. un dominio público además del de Vercel),
# separados por coma. APP_URL siempre se acepta. Vacío = solo APP_URL.
ORIGENES_PERMITIDOS=
# PostgreSQL (local: npm run db:up)
DATABASE_URL=postgres://dualcampus:dualcampus@localhost:5433/dualcampus
# Clave para firmar la sesión, mínimo 32 caracteres
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESION_DURACION_HORAS=12
# Cliente OAuth de Google (tipo "Aplicación web")
# URI de redirección autorizada: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dominios de Google Workspace aceptados, separados por coma. Vacío = cualquiera (útil en desarrollo)
DOMINIOS_PERMITIDOS=

# H55 - Avisos de corrección. Requiere remitente verificado en Brevo.
# Si están vacíos, la corrección se guarda y el aviso queda FALLIDO para H56.
AVISOS_BREVO_API_KEY=
AVISOS_CORREO_REMITENTE=
AVISOS_CORREO_NOMBRE=DualCampus
# H51: secreto compartido con el programador diario de Vercel.
CRON_SECRET=
